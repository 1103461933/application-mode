apiVersion: apps/v1
kind: Deployment
metadata:
  name: flink-session-jobmanager
  namespace: {{ .Values.namespace }}
spec:
  replicas: {{ .Values.jobManager.replicas }}
  selector:
    matchLabels:
      app: flink-session
      component: jobmanager
  template:
    metadata:
      labels:
        app: flink-session
        component: jobmanager
    spec:
      containers:
        - name: jobmanager
          image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
          args: ["jobmanager"]
          ports:
            - containerPort: 8081
          env:
            - name: JOB_MANAGER_RPC_ADDRESS
              value: flink-session-jobmanager
          resources:
            requests:
              cpu: {{ .Values.jobManager.cpuRequest | quote }}
              memory: {{ .Values.jobManager.memoryRequest | quote }}
            limits:
              cpu: {{ .Values.jobManager.cpuLimit | quote }}
              memory: {{ .Values.jobManager.memoryLimit | quote }}
